# DevSecOps Platform Environment Configuration Example

# Server Configuration
PORT=8080
DEMO_MODE=true
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/devsecops_db
SPRING_DATASOURCE_USERNAME=devsecops_user
SPRING_DATASOURCE_PASSWORD=devsecops_secure_pass_2026

# HashiCorp Vault Integration
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=devsecops-vault-root-token
VAULT_KV_MOUNT=secret

# SCM and CI/CD Integrations
GITHUB_TOKEN=your_personal_access_token
JENKINS_URL=http://localhost:8080
JENKINS_USER=admin
JENKINS_API_TOKEN=your_jenkins_api_token

# Security Gate Enforcement Policies
BLOCK_ON_CRITICAL_CVE=true
BLOCK_ON_EXPOSED_SECRETS=true
REQUIRE_COSIGN_SIGNING=true
REQUIRE_NON_ROOT_CONTAINER=true

# Notification Webhooks
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
ALERT_EMAIL_RECIPIENTS=secops-team@enterprise.internal
